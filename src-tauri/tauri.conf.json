{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retranslator",
  "version": "1.0.0",
  "identifier": "com.neodym121.retranslator",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": { "script": "npm run build", "wait": true },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Retranslator",
        "width": 960,
        "height": 660,
        "minWidth": 800,
        "minHeight": 540,
        "maxWidth": 1280,
        "maxHeight": 900,
        "maximizable": false,
        "center": true,
        "create": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#080808"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "DeveloperTool",
    "shortDescription": "Local Anthropic-compatible gateway for Claude Desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
